{
    "name": "symfon/object-translation-bundle",
    "description": "Translate your entities",
    "type": "symfony-bundle",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Symfon\\ObjectTranslationBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Symfon\\ObjectTranslationBundle\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Grzegorz Majta",
            "email": "grzegorz.majta@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.4",
        "symfony/framework-bundle": "^8.0",
        "symfony/translation": "^8.0",
        "doctrine/doctrine-bundle": "^3.2",
        "doctrine/orm": "^3.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.1",
        "symfony/phpunit-bridge": "^8.0",
        "zenstruck/foundry": "^2.10"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
